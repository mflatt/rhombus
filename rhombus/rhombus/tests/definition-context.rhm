#lang rhombus/and_meta

space.enforest example:
  space_path #{rhombus/def_ctx_example}
  macro_definer macro:
    ~def_ctx
  meta_namespace example_meta:
    parse_syntax_class Parsed(def_ctx)
    parse_definition_context_argument def_ctx

expr.macro 'sub:
              $form
              ...
              $end':
  let ctx = syntax_meta.make_definition_context()
  syntax_meta.add_definitions(ctx, '$form; ...')
  match end
  | '$(e :: example_meta.Parsed(ctx))':
      e

check:
  sub:
    example.macro 'hi':
      '"ok"'
    hi
  ~is "ok"

check:
  sub:
    example.macro 'hi $post':
      '"also ok"'
    hi any_id
  ~is "also ok"

  