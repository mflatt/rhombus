#lang rhombus/static/and_meta
import:
  "type.rhm" open
  "base_type.rhm".int_t
  lib("ffi2/main.rkt") as ffi2:
    expose:
      #{ffi2-malloc} as ffi2_malloc
      #{ffi2-ref} as ffi2_ref
      #{ffi2-set!} as ffi2_set
      array

export:
  Pointer
  only_space type:
    *
    #%index
  malloc
  new
  mem

annot.macro 'Pointer':
  annot_meta.pack_predicate('ffi2.#{ptr_t?}',
                            '()')

type.macro '$t *':
  ~all_stx: stx
  ~stronger_than: ~other
  let opque_ptr_t = type_meta.unpack_opaque_pointer(t)
  if opque_ptr_t
  | type_meta.pack_type(opque_ptr_t)
      .relocate_span([stx])
  | let t = type_meta.unpack_type(t)
    type_meta.pack_pointer('[array, $t, #{*}]', t)
      .relocate_span([stx])

type.macro '$t #%index [$(n :: Int)]':
  ~all_stx: stx
  ~stronger_than: ~other
  unless n.unwrap() >= 0
  | syntax_meta.error("size must be nonnegative", stx, n)
  let t = type_meta.unpack_type(t)
  type_meta.pack_pointer('[array, $t, $n]', t)
    .relocate_span([stx])

meta:
  syntax_class MallocMode:
    kind: ~sequence
  | '~gcable':
      field mode = '~gcable'
  | '~immobile':
      field mode = '~#{gcable-immobile}'
  | '~traced':
      field mode = '~#{gcable-traced}'
  | '~traced_immobile':
      field mode = '~#{gcable-traced-immobile}'
  | '~manual':
      field mode = '~manual'
  | '':
      field mode = '~gcable'

expr.macro
| 'malloc $(m :: MallocMode) ~as ($(t :: type_meta.Parsed)) ($(e :: expr_meta.Parsed))':
    expr_meta.pack_s_exp(['ffi2_malloc', m.mode, e,
                          '~as', type_meta.s_exp(type_meta.unpack_type(t))])
| 'malloc $(m :: MallocMode) ~as $t ... ($e ...)':
    let '$(t :: type_meta.Parsed)' = '$t ...'
    let '$(e :: expr_meta.Parsed)' = '$e ...'
    expr_meta.pack_s_exp(['ffi2_malloc', m.mode, e,
                          '~as', type_meta.s_exp(type_meta.unpack_type(t))])
| 'malloc $(m :: MallocMode) ($(e :: expr_meta.Parsed))':
    expr_meta.pack_s_exp(['ffi2_malloc', m.mode, e])

expr.macro 'new $(m :: MallocMode) $(t :: type_meta.AfterPrefixParsed('int_t')) $()':
  ~all_stx: stx
  let tail = '$t.tail ...'
  fun annoted(e, ann):
    let ann = syntax_meta.dynamic_name(ann, ~space: annot_meta.space, ~as_static: #true)
    '$e :~ $ann'
  fun maybe_annoted(e):
    match (type_meta.unpack_union_proc_ids(t)
             || type_meta.unpack_struct_proc_ids(t))
    | '[$_, $_, $ann, $_, ...]':
        annoted(e, ann)
    | ~else:
        e
  fun default():
    values(maybe_annoted(
             expr_meta.pack_s_exp(['ffi2_malloc', type_meta.s_exp(type_meta.unpack_type(t))])
           ),
           tail)
  match tail
  | '($(field_id :: Identifier): $e) $tail ...' when type_meta.unpack_union_proc_ids(t):
      match type_meta.unpack_union_proc_ids(t)
      | '[$ctr, [$field, ...], $ann, $_, ...]':
          unless field_id.unwrap() in [field.unwrap(), ...]
          | syntax_meta.error("unrecognized field for union", stx, field_id)
          annoted(expr_meta.pack_s_exp([ctr, field_id, m.mode, expr_meta.pack_expr('block: $e')]),
                  ann)
  | '($e, ...) $tail ...':
      match type_meta.unpack_struct_proc_ids(t)
      | '[$ctr, [$field, ...], $ann, $_, ...]':
          unless [field, ...].length() == [e, ...].length()
          | syntax_meta.error("incorrect constructor argument count", stx)
          annoted(expr_meta.pack_s_exp([ctr, m.mode, expr_meta.pack_expr(e), ...]),
                  ann)
      | ~else:
          default()
  | ~else:
      default()

expr.macro
| 'mem *($(t :: type_meta.Parsed)) $lhs ... := $(e :: expr_meta.AfterInfixParsed('*')) $()':
    ~all_stx: stx
    let '$(lhs :: expr_meta.Parsed)' = '$lhs ...'        
    values(expr_meta.pack_s_exp(['ffi2_set',
                                 lhs,
                                 type_meta.s_exp(type_meta.unpack_pointer_element(stx, t)),
                                 e]),
           '$e.tail ...')
| 'mem *($(t :: type_meta.Parsed)) $(e :: expr_meta.AfterInfixParsed('*')) $()':
    ~all_stx: stx
    values(expr_meta.pack_s_exp(['ffi2_ref',
                                 e,
                                 type_meta.s_exp(type_meta.unpack_pointer_element(stx, t))]),
           '$e.tail ...')
