#lang rhombus/static/and_meta
import:
  "type.rhm" open

meta:
  namespace ffi2:
    import:
      meta -1:
        lib("ffi2/main.rkt") open
    export fun pack(id :~ Identifier):
      id.replace_scopes('here')

decl.macro 'bounce:
              $id
              ...':
  '«export type.macro '$id':
      ~all_stx: stx
      type_meta.pack_type(ffi2.pack('$id')).relocate(stx)
    ...»'

bounce:
  int8_t
  uint8_t
  byte_t
  int16_t
  uint16_t
  int32_t
  uint32_t
  int64_t
  uint64_t
  short_t
  ushort_t
  int_t
  uint_t
  long_t
  ulong_t
  intptr_t
  uintptr_t
  size_t
  ssize_t
  float_t
  double_t
  intwchar_t
  wchar_t
  bool_t
  boolint
  racket_t
  bytes_t
  bytes_ptr_t
  path_t

export type.macro 'void_t':
  ~all_stx: stx
  type_meta.pack_void(ffi2.pack('void_t')).relocate(stx)

export type.macro 'ptr_t':
  ~all_stx: stx
  type_meta.pack_generic_pointer(ffi2.pack('ptr_t')).relocate(stx)

module string:
  export type.macro 'mutable_string_t':
    ~all_stx: stx
    type_meta.pack_type(ffi2.pack('string_t')).relocate(stx)

/*
  void_t*
  void_t* /gcable
*/
