#lang rhombus/static/and_meta
import:
  lib("ffi2/main.rkt") as ffi2:
    expose:
      #{ffi2-sizeof} as ffi2_sizeof

export:
  type
  meta:
    type_meta

module api:
  export:
    sizeof

space.enforest type:
  space_path rhombus/ffi/type
  macro_definer macro
  meta_namespace type_meta:
    parse_syntax_class Parsed
    parse_prefix_more_syntax_class AfterPrefixParsed
    parse_infix_more_syntax_class AfterInfixParsed
    parsed_packer pack
    parsed_unpacker unpack
    export:
      pack_type
      pack_tuple
      pack_arrow
      pack_pointer
      pack_opaque
      pack_struct
      pack_union
      pack_void
      pack_generic_pointer
      pack_variable_array
      unpack_type
      unpack_pointer_element
      unpack_opaque_pointer
      unpack_tuple_args
      unpack_arrow
      unpack_struct_proc_ids
      unpack_union_proc_ids
      unpack_void
      unpack_generic_pointer
      unpack_variable_array
      s_exp
      
    fun pack_type(t :: Term) :~ Syntax:
      pack('[($t), #false, #false]')
    fun pack_tuple(args) :~ Syntax:
      pack('[#false, ~tuple, $args]')
    fun pack_pointer(t :: Term, elem_t :: Term) :~ Syntax:
      pack('[($t), ~pointer, $elem_t]')
    fun pack_arrow(t :: Term) :~ Syntax:
      pack('[($t), ~arrow, #false]')
    fun pack_opaque(ptr_t :: Term) :~ Syntax:
      pack('[#false, ~opaque, $ptr_t]')
    fun pack_struct(t :: Term, proc_ids) :~ Syntax:
      pack('[($t), ~struct, $proc_ids]')
    fun pack_union(t :: Term, proc_ids) :~ Syntax:
      pack('[($t), ~union, $proc_ids]')
    fun pack_void(t :: Term) :~ Syntax:
      pack('[($t), ~void, #false]')
    fun pack_generic_pointer(t :: Term) :~ Syntax:
      pack('[($t), ~ptr_t, #false]')
    fun pack_variable_array(t :: Term, e_seq) :~ Syntax:
      pack('[#false, ~vararray, ($t, $e_seq)]')

    fun unpack_type(t :: Syntax, ~void_ok = #false):
      match unpack(t)
      | '[$_, ~opaque, $_]': syntax_meta.error("expected a non-opaque type", t)
      | '[$_, ~tuple, $_]': syntax_meta.error("expected a single type", t)
      | '[$_, ~vararray, $_]': syntax_meta.error("expected a fixed-sized array", t)
      | '[$_, ~void, $_]' when !void_ok: syntax_meta.error("void type allowed only in return positions", t)
      | '[($(e :: Term)), $_, $_]': e.relocate(t)
    fun unpack_pointer_element(stx, t :: Syntax):
      match unpack(t)
      | '[$_, ~pointer, $elem_t]': elem_t
      | '[$_, ~vararray, ($elem_t, $_)]': elem_t
      | ~else: stx && syntax_meta.error("expected a dereferenceable pointer type", stx, t)
    fun unpack_opaque_pointer(t :: Syntax):
      match unpack(t)
      | '[$_, ~opaque, $ptr_t]': ptr_t
      | ~else: #false
    fun unpack_tuple_args(t :: Syntax):
      match unpack(t)
      | '[$_, ~tuple, $args]': args
      | ~else: #false
    fun unpack_arrow(t :: Syntax):
      recur loop(t = unpack(t)):
        match t
        | '[$_, ~arrow, $_]': #true
        | ~else: #false
    fun unpack_struct_proc_ids(t :: Syntax):
      match unpack(t)
      | '[$_, ~struct, $proc_ids]': proc_ids
      | ~else: #false
    fun unpack_union_proc_ids(t :: Syntax):
      match unpack(t)
      | '[$_, ~union, $proc_ids]': proc_ids
      | ~else: #false
    fun unpack_void(t :: Syntax):
      match unpack(t)
      | '[$_, ~void, $_]': #true
      | ~else: #false
    fun unpack_generic_pointer(t :: Syntax):
      match unpack(t)
      | '[$_, ~ptr_t, $_]': #true
      | ~else: #false
    fun unpack_variable_array(t :: Syntax):
      match unpack(t)
      | '[$_, ~vararray, ($elem_t, $n_seq)]': [elem_t, n_seq]
      | ~else: #false

    fun s_exp(t :: Syntax):
      match t
      | '[$sub_t, ...]': [s_exp(sub_t), ...]
      | ~else: t

expr.macro 'sizeof($(t :: type_meta.Parsed))':
  expr_meta.pack_s_exp(['ffi2_sizeof', type_meta.s_exp(type_meta.unpack_type(t))])
