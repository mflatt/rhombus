#lang rhombus/static/and_meta
import:
  "type.rhm" open
  lib("ffi2/main.rkt") as ffi2:
    expose:
      -> as arrow

export:
  only_space type:
    #%parens
    ->

type.macro
| '#%parens $(args && '($t, ..., ~varargs, $var_t, ...)')':
    let '($(t :: type_meta.Parsed), ...)' = '($t, ...)'
    let '($(var_t :: type_meta.Parsed), ...)' = '($var_t, ...)'
    let tup = '($(type_meta.unpack_singleton(t)), ..., $(type_meta.unpack_singleton(var_t)), ...)'
    type_meta.pack_tuple(tup, [t, ...].length()).relocate(args)
| '#%parens ($(t :: type_meta.Parsed))':
    t
| '#%parens $(args && '($(t :: type_meta.Parsed), ...)')':
    let tup = '($(type_meta.unpack_singleton(t)), ...)'
    type_meta.pack_tuple(tup, #false).relocate(args)

type.macro '$arg_ts -> $(result_t :: type_meta.AfterInfixParsed('->')) $()':
  ~all_stx: stx
  let tail = '$result_t.tail ...'
  let varargs = type_meta.unpack_tuple_varargs(arg_ts)
  let '($arg_t, ...)' = type_meta.unpack_tuple(arg_ts)
  let [arg_t, ...]:
    if !varargs
    | [arg_t, ...]
    | let args = [arg_t, ...]
      args.take(varargs) ++ ['~varargs'] ++ args.drop(varargs)
  let result_t = type_meta.unpack_singleton(result_t)
  values(type_meta.pack_arrow('[arrow, $arg_t, ..., $result_t]')
           .relocate_span([stx]),
         tail)
